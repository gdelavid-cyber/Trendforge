# Payment
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Lead Data
BETTERCONTACT_API_KEY=

# Email (per-venture configurable, these are defaults)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=
IMAP_HOST=
IMAP_PORT=993

# Platform
PLATFORM_URL=http://localhost:3000

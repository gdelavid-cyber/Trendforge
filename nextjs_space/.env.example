# nextjs_space/.env.example — copy to .env / .env.local and fill in

# Database (Supabase Postgres)
DATABASE_URL="postgresql://user:pass@db.xxxx.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:pass@db.xxxx.supabase.co:5432/postgres"

# Inference (Primary)
INFERHUB_API_KEY="sk-airo-..."
INFERHUB_MODEL="gemini-3.6-flash"
INFERHUB_BASE_URL="https://api.inferhub.dev/v1"

# Inference (Fallbacks)
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
ABACUSAI_API_KEY=""

# Internal Security
PIPELINE_API_KEY="generate-a-uuid-v4-here"
CRON_SECRET="generate-a-second-secret-here"
NEXTAUTH_SECRET="generate-a-random-hash-here"
NEXTAUTH_URL="http://localhost:3000"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PREMIUM="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_ENTERPRISE="price_..."

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# InferHub earnings auto-reinvestment
INFERHUB_REINVEST_MIN_USD=1.00
INFERHUB_REINVEST_INTERVAL_MIN=60
INFERHUB_ALERT_WEBHOOK=

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  FREE
  PREMIUM
  PRO
  ELITE
  ENTERPRISE
  ADMIN
}

enum RiskTolerance {
  LOW
  MEDIUM
  HIGH
}

enum TrendCategory {
  AI_TOOLS
  LOCAL_SERVICES
  CRYPTO_FINANCE
  ECOMMERCE
  AI_CONTENT
  AGENT_ECONOMY
  EDUCATION
  HARDWARE
  DATA_SCIENCE
  OTHER
}

enum TrendStatus {
  ACTIVE
  COOLING
  EXPIRED
}

enum TaskDifficulty {
  ZERO
  LOW
  MEDIUM
  HIGH
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum UserTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  STEP_EXECUTING
  PENDING_APPROVAL
  COMPLETED
  FAILED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum FavorStatus {
  OPEN
  FULFILLED
  CANCELLED
}

enum MentorshipStatus {
  ACTIVE
  COMPLETED
}

enum VoteType {
  UP
  DOWN
}

model User {
  id                    String           @id @default(cuid())
  email                 String           @unique
  name                  String?
  passwordHash          String
  role                  UserRole         @default(FREE)
  stripeCustomerId      String?          @unique
  stripeSubscriptionId  String?
  subscriptionStatus    String?
  skills                String[]         @default([])
  riskTolerance         RiskTolerance    @default(MEDIUM)
  totalEarnings         Float            @default(0)
  firstHundredAt        DateTime?
  firstThousandAt       DateTime?
  favorCredits          Int              @default(3)
  isVIP                 Boolean          @default(false)
  isMentor              Boolean          @default(false)
  mentorId              String?
  mentor                User?            @relation("MentorMentee", fields: [mentorId], references: [id])
  mentees               User[]           @relation("MentorMentee")
  referralCode          String?          @unique
  successFeeOptIn       Boolean          @default(false)
  bonusAgentRuns        Int              @default(0)
  communityPoints       Int              @default(0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  userTasks             UserTask[]
  approvals             Approval[]
  companions            Companion[]
  llmKey                UserLlmKey?
  successStories        SuccessStory[]
  sentFavors            Favor[]          @relation("FavorFrom")
  receivedFavors        Favor[]          @relation("FavorTo")
  templates             Template[]
  votes                 Vote[]
  mentorshipsAsMentor   Mentorship[]     @relation("MentorRel")
  mentorshipsAsMentee   Mentorship[]     @relation("MenteeRel")
  notifications         Notification[]
  badges                UserBadge[]
  posts                 CommunityPost[]
  comments              CommunityComment[]
  referralsMade         Referral[]       @relation("ReferralsMade")
  referredBy            Referral?        @relation("ReferredUser")
  workflows             AgentWorkflow[]
  web4Agents            Web4Agent[]
  userCosmetics         UserCosmetic[]
  marketplaceListings   MarketplaceListing[] @relation("SellerListings")
  cosmeticPurchases     CosmeticTransaction[] @relation("BuyerTransactions")
  cosmeticSales         CosmeticTransaction[] @relation("SellerTransactions")

  @@index([role])
  @@index([email])
}

model Trend {
  id                  String         @id @default(cuid())
  name                String
  sourcePlatforms     String[]       @default([])
  mentionVelocity     Float          @default(0)
  sentimentScore      Float          @default(0)
  confidence          Float          @default(0)
  category            TrendCategory  @default(OTHER)
  status              TrendStatus    @default(ACTIVE)
  detectedAt          DateTime       @default(now())
  hoursSinceDetection Float          @default(0)
  createdAt           DateTime       @default(now())

  tasks               Task[]

  @@index([status])
  @@index([detectedAt])
  @@index([category])
}

model Task {
  id                    String         @id @default(cuid())
  trendId               String
  trend                 Trend          @relation(fields: [trendId], references: [id])
  title                 String
  description           String
  steps                 Json           @default("[]")
  difficulty            TaskDifficulty @default(LOW)
  startupCost           Float          @default(0)
  timeToFirstDollar     String?        @default("1-3 days")
  estimatedEarningsLow  Float          @default(0)
  estimatedEarningsHigh Float          @default(0)
  riskLevel             RiskLevel      @default(LOW)
  riskExplanation       String?
  mitigationStrategy    String?
  toolLinks             Json           @default("[]")
  proTip                String?
  category              TrendCategory  @default(OTHER)
  qualityScore          Float          @default(0)
  isVerified            Boolean        @default(false)
  isFeatured            Boolean        @default(false)
  upvotes               Int            @default(0)
  downvotes             Int            @default(0)
  weekOf                DateTime       @default(now())
  disclaimer            String         @default("For educational purposes only. Trendly is not responsible for any financial losses.")
  requiresOptIn         Boolean        @default(false)
  createdAt             DateTime       @default(now())
  generatedAt           DateTime       @default(now())
  expiresAt             DateTime?
  trendScore            Float          @default(0)

  userTasks             UserTask[]
  successStories        SuccessStory[]
  favors                Favor[]
  templates             Template[]
  votes                 Vote[]

  @@index([trendId])
  @@index([difficulty])
  @@index([category])
  @@index([weekOf])
  @@index([isFeatured])
  @@index([isVerified])
}

model UserTask {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  taskId           String
  task             Task           @relation(fields: [taskId], references: [id])
  status           UserTaskStatus @default(NOT_STARTED)
  stepsCompleted   Int            @default(0)
  earningsReported Float?         @default(0)
  launchedAt       DateTime?
  completedAt      DateTime?
  hasOptedInRisk   Boolean        @default(false)
  mode             String?
  currentStep      Int?
  stepResults      Json?
  companionId      String?

  approvals        Approval[]
  createdAt        DateTime       @default(now())

  @@unique([userId, taskId])
  @@index([userId])
  @@index([taskId])
  @@index([status])
}

model SuccessStory {
  id                     String             @id @default(cuid())
  userId                 String
  user                   User               @relation(fields: [userId], references: [id])
  taskId                 String
  task                   Task               @relation(fields: [taskId], references: [id])
  earningsAmount         Float
  earningsScreenshotUrl  String?
  earningsScreenshotPath String?
  isPublicScreenshot     Boolean            @default(true)
  description            String
  verificationStatus     VerificationStatus @default(PENDING)
  verifiedAt             DateTime?
  isPublished            Boolean            @default(false)
  createdAt              DateTime           @default(now())

  @@index([verificationStatus])
  @@index([userId])
  @@index([taskId])
}

model Favor {
  id          String      @id @default(cuid())
  fromUserId  String
  fromUser    User        @relation("FavorFrom", fields: [fromUserId], references: [id])
  toUserId    String?
  toUser      User?       @relation("FavorTo", fields: [toUserId], references: [id])
  taskId      String?
  task        Task?       @relation(fields: [taskId], references: [id])
  description String
  status      FavorStatus @default(OPEN)
  creditValue Int         @default(1)
  createdAt   DateTime    @default(now())

  @@index([fromUserId])
  @@index([status])
}

model Template {
  id           String   @id @default(cuid())
  taskId       String?
  task         Task?    @relation(fields: [taskId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  title        String
  description  String
  fileUrl      String?
  filePath     String?
  isPublicFile Boolean  @default(true)
  price        Float    @default(0)
  category     String   @default("general")
  downloads    Int      @default(0)
  revenue      Float    @default(0)
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([isApproved])
  @@index([category])
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  voteType  VoteType
  createdAt DateTime @default(now())

  @@unique([userId, taskId])
  @@index([taskId])
}

model Mentorship {
  id                  String           @id @default(cuid())
  mentorId            String
  mentor              User             @relation("MentorRel", fields: [mentorId], references: [id])
  menteeId            String
  mentee              User             @relation("MenteeRel", fields: [menteeId], references: [id])
  status              MentorshipStatus @default(ACTIVE)
  revenueSharePercent Int              @default(10)
  createdAt           DateTime         @default(now())

  @@unique([mentorId, menteeId])
  @@index([mentorId])
  @@index([menteeId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model TrendIngestionLog {
  id              String   @id @default(cuid())
  source          String
  status          String
  recordsIngested Int      @default(0)
  errorMessage    String?
  executedAt      DateTime @default(now())
  durationMs      Int      @default(0)

  @@index([executedAt])
}

model WeeklyDigest {
  id           String   @id @default(cuid())
  weekOf       DateTime
  tasks        Json     @default("[]")
  trendSummary String?
  sentAt       DateTime?
  createdAt    DateTime @default(now())

  @@index([weekOf])
}

model BrainDecision {
  id            String   @id @default(cuid())
  timestamp     DateTime @default(now())
  type          String   // 'insight', 'action', 'anomaly'
  parameters    Json     // structured parameters
  outcome       String?  @default("pending") // 'pending', 'approved', 'rejected', 'executed'
  feedbackScore Float?   // 0-1, measured after execution
  executedBy    String?  // 'admin' or 'system'
  title         String?  @default("Optimization Decision")
  description   String?
  riskLevel     String?  @default("MEDIUM") // 'LOW', 'MEDIUM', 'HIGH'
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([outcome])
  @@index([type])
  @@index([timestamp])
}

model BrainMetric {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  metricName  String
  value       Float
  source      String   // 'database', 'stripe', 'vercel', 'sendgrid'
  tags        Json     @default("{}") // { environment: 'prod', region: 'us-east' }

  @@index([metricName])
  @@index([timestamp])
  @@index([source])
}

model AgentRun {
  id            String    @id @default(cuid())
  userId        String
  agentType     String    // 'reddit_scraper', 'prediction_arbitrage', 'openclaw_deployer', 'ai_video_maker', 'micro_saas_builder'
  status        String    @default("queued") // 'queued', 'running', 'completed', 'failed', 'cancelled'
  parameters    Json      @default("{}")
  result        Json?
  logs          String    @default("") // concatenated log messages
  userFeedback  String?
  userRating    Int?      // 1-5
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  errorMessage  String?
  costCents     Int       @default(0)
  durationMs    Int?      // execution time in milliseconds
  correlationId String?

  @@index([userId])
  @@index([agentType])
  @@index([status])
  @@index([createdAt])
}

model AgentQuota {
  userId     String
  agentType  String
  runsUsed   Int      @default(0)
  runsLimit  Int      @default(3) // 3 runs/week for free tier
  weekStart  DateTime @default(now())

  @@id([userId, agentType])
  @@index([userId])
}

model AgentWorkflow {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  definition  Json     // Array of agent steps with input mappings
  status      String   @default("draft") // 'draft', 'active', 'completed', 'failed'
  lastRunAt   DateTime?
  result      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  badgeId   String   // 'first_move', 'first_agent_run', 'hundred_club', 'thousand_club', 'top_earner', 'referral_champion'
  earnedAt  DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

model CommunityPost {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  title     String
  content   String
  category  String             @default("GENERAL") // 'GENERAL', 'HELP', 'SUCCESS_STORIES', 'AGENT_IDEAS'
  upvotes   Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  comments  CommunityComment[]

  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

model CommunityComment {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime      @default(now())

  @@index([postId])
  @@index([userId])
}

model Referral {
  id               String    @id @default(cuid())
  referrerId       String
  referrer         User      @relation("ReferralsMade", fields: [referrerId], references: [id])
  referredEmail    String?
  referredUserId   String?   @unique
  referredUser     User?     @relation("ReferredUser", fields: [referredUserId], references: [id])
  code             String
  signedUpAt       DateTime  @default(now())
  upgradedAt       DateTime?
  commissionEarned Float     @default(0)
  status           String    @default("registered") // 'registered', 'active', 'upgraded'

  @@index([referrerId])
  @@index([code])
}

// ==========================================
// TRENDLY WEB4 — THE WEALTH OPERATING SYSTEM
// ==========================================

enum AgentStatus {
  CREATED
  ACTIVE
  PAUSED
  DYING
  DEAD
  REPRODUCING
}

enum CosmeticCategory {
  SKIN
  ACCESSORY
  ANIMATION
  EFFECT
  BACKGROUND
  VOICE
}

enum CosmeticRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

model Web4Agent {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  name              String
  description       String?
  archetype         String          @default("GENERALIST") // "DATA_MINER", "DEFI_ARBITRAGEUR", "LEAD_HUNTER", "VIRAL_CREATOR", "SAAS_ARCHITECT"
  walletAddress     String          @unique
  walletBalance     Float           @default(100.0) // Initial test liquidity (USDC)
  status            AgentStatus     @default(ACTIVE)
  creationDate      DateTime        @default(now())
  lastActive        DateTime        @default(now())
  totalEarnings     Float           @default(0)
  totalCosts        Float           @default(0)
  profit            Float           @default(0)
  survivalScore     Float           @default(85) // 0-100 score
  riskExposure      Float           @default(0.2) // 0-1
  gracePeriodEnds   DateTime?
  parentAgentId     String?         // Lineage / genetic inheritance
  skills            Json            // Workflow DAG nodes
  memory            Json?           // Experience reflection logs
  constitution      Json?           // Operational guardrails
  avatarConfig      Json?           // GTA skin, accessories, animations, particle auras
  personality       String?         // Core prompt / conversational personality instructions
  voiceId           String?         // TTS voice ID (ElevenLabs / Google voice)
  emotionsEnabled   Boolean         @default(true)
  ttsEnabled        Boolean         @default(true)
  sttEnabled        Boolean         @default(true)
  eip8004Hash       String?         // Verifiable on-chain identity hash
  mcpEndpoints      Json?           // Registered MCP tool servers
  generation        Int             @default(1)
  reproductionCount Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  marketplaceListings MarketplaceListing[]
  battlesAsChallenger AgentBattle[]        @relation("ChallengerAgent")
  battlesAsDefender   AgentBattle[]        @relation("DefenderAgent")
  survivalLogs        AgentSurvivalLog[]

  @@index([userId])
  @@index([status])
  @@index([survivalScore])
}

model Cosmetic {
  id            String            @id @default(cuid())
  name          String
  description   String?
  category      CosmeticCategory
  rarity        CosmeticRarity    @default(COMMON)
  previewUrl    String
  modelUrl      String?
  thumbnailUrl  String
  price         Float             @default(0) // in TREND tokens / USD
  marketable    Boolean           @default(true)
  season        String?           @default("Season 1: Genesis")
  unlockMethod  String?           @default("FREE_QUEST") // quest, achievement, referral, battlepass, shop
  renderConfig  Json?             // Swarm-published CosmeticRenderConfig override
  assetUrl      String?           // Swarm-published 2D PNG asset URL
  createdAt     DateTime          @default(now())

  userCosmetics       UserCosmetic[]
  marketplaceListings MarketplaceListing[]
  transactions        CosmeticTransaction[]

  @@index([category])
  @@index([rarity])
}

model UserCosmetic {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  cosmeticId  String
  cosmetic    Cosmetic  @relation(fields: [cosmeticId], references: [id])
  equipped    Boolean   @default(false)
  unlockedAt  DateTime  @default(now())
  unlockedVia String    @default("INVENTORY_GENESIS")

  @@unique([userId, cosmeticId])
  @@index([userId])
}

model MarketplaceListing {
  id               String     @id @default(cuid())
  sellerId         String
  seller           User       @relation("SellerListings", fields: [sellerId], references: [id])
  agentId          String?
  agent            Web4Agent? @relation(fields: [agentId], references: [id])
  cosmeticId       String?
  cosmetic         Cosmetic?  @relation(fields: [cosmeticId], references: [id])
  price            Float
  currency         String     @default("USDC") // USD, USDC, TREND
  status           String     @default("ACTIVE") // ACTIVE, SOLD, CANCELLED
  itemType         String     @default("AGENT") // AGENT, COSMETIC, HIRE_SERVICE
  hireDurationDays Int?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([sellerId])
  @@index([status])
  @@index([itemType])
}

model CosmeticTransaction {
  id          String    @id @default(cuid())
  buyerId     String
  buyer       User      @relation("BuyerTransactions", fields: [buyerId], references: [id])
  sellerId    String?
  seller      User?     @relation("SellerTransactions", fields: [sellerId], references: [id])
  cosmeticId  String
  cosmetic    Cosmetic  @relation(fields: [cosmeticId], references: [id])
  amount      Float
  currency    String    @default("USDC")
  status      String    @default("COMPLETED")
  createdAt   DateTime  @default(now())

  @@index([buyerId])
}

model AgentBattle {
  id             String    @id @default(cuid())
  challengerId   String
  challenger     Web4Agent @relation("ChallengerAgent", fields: [challengerId], references: [id])
  defenderId     String
  defender       Web4Agent @relation("DefenderAgent", fields: [defenderId], references: [id])
  arenaType      String    @default("ARBITRAGE_SHOWDOWN") // ARBITRAGE_SHOWDOWN, SCRAPER_SPEEDRUN, SAAS_HACKATHON, VIRAL_TRAFFIC_DUEL
  winnerId       String?
  yieldGenerated Float     @default(0)
  logs           Json      // Turn-by-turn simulation logs
  status         String    @default("COMPLETED")
  createdAt      DateTime  @default(now())

  @@index([challengerId])
  @@index([defenderId])
}

model AgentSurvivalLog {
  id           String    @id @default(cuid())
  agentId      String
  agent        Web4Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  event        String    // BALANCE_CHECK, COMPUTE_BURN, PROFIT_INFLOW, SOS_TRIGGERED, SELF_DESTRUCT, REPRODUCED
  burnAmount   Float     @default(0)
  yieldAmount  Float     @default(0)
  balanceAfter Float     @default(0)
  details      Json?
  createdAt    DateTime  @default(now())

  @@index([agentId])
  @@index([createdAt])
}

model OnboardingProgress {
  id          String    @id @default(cuid())
  userId      String    @unique
  step        Int       @default(0) // 0 to 5
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model Battle {
  id          String    @id @default(cuid())
  name        String
  tier        String    // bronze, silver, gold, platinum
  entryFee    Float
  prizePool   Float
  status      String    @default("open") // open, in_progress, completed
  winnerId    String?
  runnerUpId  String?
  startDate   DateTime  @default(now())
  endDate     DateTime?
  logs        Json?
  createdAt   DateTime  @default(now())
}

model Grant {
  id          String    @id @default(cuid())
  userId      String
  amount      Float     @default(25.0) // $25 USDC micro-grant
  status      String    @default("available") // available, claimed, used, expired
  claimedAt   DateTime?
  usedAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model ComplianceAgreement {
  id               String    @id @default(cuid())
  userId           String
  isOver18         Boolean   @default(true)
  riskAcknowledged Boolean   @default(true)
  termsAccepted    Boolean   @default(true)
  agreedAt         DateTime  @default(now())
  ipAddress        String?

  @@index([userId])
}

// ============================================================================
// FORGE SWARM ENUMS & MODELS (ADDITIVE)
// ============================================================================

enum SpeciesRole {
  SCOUT
  DESIGNER
  ART_WORKER
  MODELER
  QA_INSPECTOR
  PUBLISHER
}

enum SpeciesStatus {
  ACTIVE
  PAUSED
  THROTTLED
  TERMINATED
}

enum InstanceStatus {
  IDLE
  WORKING
  BACKOFF
  ERROR
}

enum JobStage {
  QUEUED
  SPEC_DESIGN
  ART_GENERATION
  MODELING_3D
  QA_INSPECTION
  PUBLISHING
  COMPLETED
  FAILED
  DEAD_LETTER
}

enum QAVerdict {
  PASS
  REJECT_RETRY
  REJECT_FATAL
  NEEDS_HUMAN_REVIEW
}

model AgentSpecies {
  id              String         @id @default(cuid())
  role            SpeciesRole    @unique
  name            String
  description     String
  status          SpeciesStatus  @default(ACTIVE)
  targetHeadcount Int            @default(1)
  maxHeadcount    Int
  dailyBudgetUsd  Float
  currentSpendUsd Float          @default(0.0)
  costPerUnitUsd  Float          @default(0.0)
  spendResetAt    DateTime       @default(now())
  config          Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  instances       AgentInstance[]
  jobsProcessed   AssetJob[]     @relation("ProcessedBySpecies")

  @@index([status])
}

model AgentInstance {
  id              String         @id @default(cuid())
  speciesId       String
  species         AgentSpecies   @relation(fields: [speciesId], references: [id])
  instanceIndex   Int
  status          InstanceStatus @default(IDLE)
  currentJobId    String?
  heartbeatAt     DateTime       @default(now())
  totalRuns       Int            @default(0)
  failedRuns      Int            @default(0)
  spendToDateUsd  Float          @default(0.0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([speciesId, instanceIndex])
  @@index([status])
  @@index([heartbeatAt])
}

model AssetJob {
  id                String        @id @default(cuid())
  catalogItemId     String
  slot              String
  rarity            String
  stage             JobStage      @default(QUEUED)
  priority          Int           @default(1) // 0=high, 1=normal, 2=low -> maps to queue tier
  attempts          Int           @default(0)
  maxAttempts       Int           @default(3)
  promptSpec        Json?
  imagePngPath      String?
  modelGlbPath      String?
  renderConfig      Json?
  totalCostUsd      Float         @default(0.0)
  errorMessage      String?
  assignedSpeciesId String?
  assignedSpecies   AgentSpecies? @relation("ProcessedBySpecies", fields: [assignedSpeciesId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  qaReviews         QAReview[]

  @@index([stage])
  @@index([catalogItemId])
  @@index([priority])
}

model QAReview {
  id             String    @id @default(cuid())
  jobId          String
  job            AssetJob  @relation(fields: [jobId], references: [id])
  inspectorId    String?
  verdict        QAVerdict
  binaryValid    Boolean   @default(false)
  alphaValid     Boolean   @default(false)
  dimensionValid Boolean   @default(false)
  glbParsedValid Boolean   @default(false)
  polyCount      Int?
  fileSizeBytes  Int
  failureReason  String?
  createdAt      DateTime  @default(now())

  @@index([jobId])
  @@index([verdict])
}

// Singleton row (id = "global") holding cross-process swarm control state.
model SwarmControl {
  id         String   @id @default("global")
  killSwitch Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

// A gated external action queued by the execution engine; the user approves
// or rejects it from /approvals before anything leaves the platform.
model Approval {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  userTaskId String
  userTask   UserTask  @relation(fields: [userTaskId], references: [id])
  stepIndex  Int
  action     Json
  status     String    @default("PENDING")
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([status])
}

// The user's forged AI companion — one owned identity across forge, world,
// execution engine and export bundles.
model Companion {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  name           String
  config         Json?
  personality    Json?
  memory         Json?
  skills         String[] @default([])
  level          Int      @default(1)
  totalEarnings  Float    @default(0)
  tasksCompleted Int      @default(0)
  rarity         String   @default("common")
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

// Bring-your-own-key companion brain. Encrypted at rest; used by the
// execution engine and chat brain ahead of platform defaults.
model UserLlmKey {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  provider     String   // 'openrouter' | 'custom'
  model        String
  baseUrl      String?
  encryptedKey String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}




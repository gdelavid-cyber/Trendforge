# worker/.env.example — copy to .env and fill in

# Core (API_BASE_URL preferred; TRENDLY_URL is the legacy fallback)
API_BASE_URL=http://localhost:3000
PIPELINE_API_KEY=generate-a-uuid-v4-here
SCRAPE_INTERVAL=300
AUTO_CLUSTER=true
BATCH_PER_SOURCE=true

# Execution mode: daemon loops forever (Docker/VPS);
# oneshot runs a single cycle then exits (Render/Vercel crons).
# Overridden by the --once CLI flag.
WORKER_MODE=daemon

# Feature flags
ENABLE_REDDIT=true
ENABLE_HACKERNEWS=true
ENABLE_TWITTER=true
ENABLE_PRODUCTHUNT=true

# Optional: official APIs (falls back to nitter/RSS if empty)
TWITTER_BEARER_TOKEN=
PRODUCTHUNT_TOKEN=
